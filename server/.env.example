# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URL (replace with your MongoDB Atlas connection string)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shareway?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/shareway

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_key_shareway_2026_dev
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_shareway_2026_dev
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Routing (OSRM Public Demo Server)
OSRM_BASE_URL=http://router.project-osrm.org
