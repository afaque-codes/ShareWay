{
  "name": "shareway",
  "version": "1.0.0",
  "private": true,
  "description": "ShareWay — Web-Based Community Ridesharing Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "client:dev": "npm run dev --workspace=client",
    "server:dev": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=client",
    "docker:db:up": "docker compose up -d",
    "docker:db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "docx": "^9.7.2"
  }
}
